# Database — Supabase
# Dev project may be Seoul; production = Sydney later (ADR 0004).
# DATABASE_URL = Transaction pooler (6543) · DIRECT_URL = Direct (5432)
# Percent-encode special characters in the password.
DATABASE_URL=
DIRECT_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — admin provisioning of invited agents. Never expose to the browser.
# Dashboard → Settings → API → Secret keys → reveal the `sb_secret_...` value
# (the legacy `service_role` JWT works too). Optional: without it, invited agents
# claim their membership by signing up with the invite link instead.
SUPABASE_SERVICE_ROLE_KEY=

# Surfaces
NEXT_PUBLIC_WEB_URL=http://web.lvh.me:3000
NEXT_PUBLIC_AGENT_URL=http://agents.lvh.me:3001
NEXT_PUBLIC_AGENCY_URL=http://agency.lvh.me:3001
# The platform admin console (ADR 0049): the console app on an admin.* host. Admins are made with
# PLATFORM_ADMIN_EMAIL=… PLATFORM_ADMIN_PASSWORD=… pnpm --filter @repo/db db:platform-admin
NEXT_PUBLIC_ADMIN_URL=http://admin.lvh.me:3001

# UI-first mock (set 1 to skip auth in console middleware while designing)
NEXT_PUBLIC_UI_PREVIEW=0

# Shared session cookie domain (agents.* + agency.*)
COOKIE_DOMAIN=.lvh.me

# AI — every call goes through packages/ai (the /chat guide and the summary
# paragraph of a saved-search alert email). Unset is a supported state: /chat
# answers 503 with a readable reason, alerts fall back to a template, and every
# other page is unaffected.
ANTHROPIC_API_KEY=
# Optional overrides. Unset = DEFAULT_CHAT_MODEL in packages/ai/src/models.ts
# (currently claude-haiku-4-5). An id that file has no price for is costed at $0.
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_ALERT_MODEL=
# Turns one process serves per day before the chat starts refusing. A ceiling on
# cost, not a security control — set a hard spend cap in the Anthropic console
# as well. Defaults to 2000.
AI_CHAT_DAILY_TURN_CAP=

# Media lives in Supabase Storage (docs/adr/0009) — see
# NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET below. These R2 values are NOT read by any
# code today; they are kept for a possible later move to Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read URL for the bucket (r2.dev subdomain or your own domain).
# This is NOT the S3 API endpoint — it is what <img src> points at.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Location ---
# One server-side key. Enable "Places API (New)" and "Geocoding API" on it,
# and restrict it by IP — it is never sent to a browser, so an HTTP-referrer
# restriction would block it instead of protecting it.
#
# Everything still works without this: address autocomplete falls back to the
# suburbs already in the database, and search falls back to matching a suburb
# by name. What is lost is the radius — an address with no coordinates cannot
# be found by distance.
GOOGLE_MAPS_API_KEY=

# The SECOND key, for the visual map. A different key from the one above, with
# different restrictions, and the two are not interchangeable:
#
#   GOOGLE_MAPS_API_KEY                  server → Google. Restrict by IP.
#                                        Places API (New) + Geocoding API.
#   NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY  browser → Google. Restrict by HTTP
#                                        referrer. Maps JavaScript API.
#
# NEXT_PUBLIC_ means this one is compiled into the page and is readable by
# anyone. That is how the Maps JavaScript API works and is not a mistake — the
# referrer restriction is what protects it, which is also why the server key
# must never be used here. Put the server key in a browser and an IP rule
# cannot defend it; put the browser key on a server and a referrer rule breaks it.
#
# Without this the maps show a short "not configured" panel and the rest of the
# app is unaffected: pins are still stored, searched and returned.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Email (M4)
RESEND_API_KEY=

# Agent invite claim-link lifetime, in minutes (default 120 = 2 hours).
# A lapsed link is re-sent from the Add Agent wizard, never extended.
AGENT_INVITE_TTL_MINUTES=120

# --- Cache invalidation ---
# The console and the public site are two Next apps in two processes, so the
# console's own revalidatePath cannot clear the public site's cache. It calls
# POST /api/revalidate instead, and this is what proves the caller is the
# console rather than anyone who found the URL.
#
# Any long random string. Unset means the endpoint refuses everything and the
# public site falls back to its own short revalidate windows.
REVALIDATE_SECRET=

# Supabase Storage bucket for listing and agent images (public reads, signed writes).
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media

# --- Scheduled search alerts (ADR 0010) ---
# The person saves a prompt and a time; a cron tick runs the frozen query and
# emails the results. packages/core/src/schedules/ and apps/web/app/api/cron/.

# Spam Act 2003 requires a commercial electronic message to identify its
# sender and give a way to contact them. buildScheduleDigestEmail THROWS
# without these rather than sending a message that cannot comply.
ALERT_SENDER_NAME=
ALERT_SENDER_ADDRESS=
# A full address, never a bare domain. `quotemydecking.com.au` on its own
# reaches Resend as `Sender Name <quotemydecking.com.au>` and is refused —
# it was set that way here for two days and every send failed validation.
# The domain part must be verified in Resend, or sends are refused with 403.
ALERT_EMAIL_FROM=alerts@quotemydecking.com.au
# HMAC key for one-click unsubscribe links. No default anywhere in code: a
# default would be a link anybody could forge for anybody else's alert.
ALERT_UNSUBSCRIBE_SECRET=
# Shared secret on POST/GET /api/cron/alerts. Unset means the endpoint
# refuses everything with 503 — an open trigger here is a bill and a mailing,
# not just a slow page.
CRON_SECRET=
# Trailing-24h spend ceilings, in USD, queried from ai_run. The chat's own
# caps are per-process and keyed on an IP, so they do not cover a cron tick.
AI_DAILY_BUDGET_USD=5
# Per person across every feature EXCEPT the console assistant, which has its own two below.
AI_DAILY_BUDGET_USD_PER_USER=0.25
# Console assistant (docs/adr/0025): per person and per agency, trailing 24 h,
# inside AI_DAILY_BUDGET_USD (which applies first if it is lower).
ASSISTANT_DAILY_BUDGET_USD_PER_USER=1
ASSISTANT_DAILY_BUDGET_USD_PER_AGENCY=10
# 1 = build and record every digest but send none. For preview deployments.
ALERTS_DRY_RUN=

# ── Email conversations in the app (docs/adr/0016) ───────────────────────────
# The domain Resend RECEIVES on. Easiest: Resend → Emails → Receiving → ⋯ →
# Receiving address, and use the part after @ (<id>.resend.app) — no DNS needed.
# Or your own subdomain with its MX pointed at Resend, e.g. reply.example.com.au.
# Replies to anything a conversation sends come back here and into the thread.
# Unset (with the secret): sending still works, replies go to the agent's own email.
MAIL_INBOUND_DOMAIN=
# Signs reply addresses and the buyer's "confirm your email" link. No default.
MAIL_REPLY_SECRET=
# Resend → Webhooks → the signing secret (whsec_…) of the endpoint pointing at
# https://<web host>/api/mail/inbound, event email.received. Unset refuses all.
RESEND_WEBHOOK_SECRET=

# ── Sending limits for platform-composed email (CRM) ─────────────────────────
# Appointment invitations now, skill emails later. A person's own reply in a
# conversation never counts. Per rolling 24 hours. Defaults: 50 and 200.
EMAIL_LIMIT_PER_AGENT_DAY=
EMAIL_LIMIT_PER_AGENCY_DAY=

# ── Integrations: Google Calendar, Zoom, Sheets, Reviews (docs/adr/0020) ─────
# Encrypts stored OAuth tokens and signs the OAuth state. 32 bytes, base64:
#   openssl rand -base64 32
# Never commit it, never put it in the database. Unset = nothing can be connected.
INTEGRATION_TOKEN_KEY=
# The old key, only while rotating (it still decrypts; new values use the new key).
INTEGRATION_TOKEN_KEY_PREVIOUS=
# Where Google/Zoom send people back. Dev: http://localhost:3001 (Google allows
# plain http only on localhost); the route hands over to the right *.lvh.me host.
# Production: leave unset (= NEXT_PUBLIC_AGENCY_URL, which must be https).
INTEGRATION_OAUTH_RETURN_BASE=
# 1 = a local pretend provider for every integration (dev only; ignored in production).
# A provider whose real client id + secret are set below uses the real one instead.
INTEGRATIONS_STUB=
# Google (Calendar now; Sheets and Reviews later share the same app). Google Cloud →
# APIs & Services → Credentials → OAuth client ID, type "Web application".
# Authorised redirect URI (dev):  http://localhost:3001/api/integrations/oauth/return
# Scopes (consent screen → Data access): calendar.events.owned, openid, email.
# Enable the "Google Calendar API" in the same project. Both values server-only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Zoom: marketplace.zoom.us → Develop → Build App → General app, user-managed.
# Scopes: meeting:write:meeting meeting:update:meeting meeting:delete:meeting
# user:read:user. Zoom refuses localhost redirects for apps with a secret, so in
# dev Zoom alone comes back through an https tunnel to port 3001 (for example
# `cloudflared tunnel --url http://localhost:3001`):
#   Redirect URL + OAuth allow list:  https://<tunnel host>/api/integrations/oauth/return
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
# Dev only: https://<tunnel host>. Unset = INTEGRATION_OAUTH_RETURN_BASE, as for Google.
ZOOM_OAUTH_RETURN_BASE=
# Outlook mail (send only) and Outlook Calendar (docs/adr/0076): ONE Microsoft Entra app registration,
# "Accounts in any organizational directory and personal Microsoft accounts", a Web platform with
#   Redirect URI:  <INTEGRATION_OAUTH_RETURN_BASE>/api/integrations/oauth/return   (dev: http://localhost:3001/…)
# Delegated Graph permissions: Mail.Send, Calendars.ReadWrite, User.Read, offline_access, openid, email.
# Certificates & secrets → a client secret (note its expiry). Unset = Outlook cannot be connected here.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Zoom app → Features → Access → Secret Token. Verifies Zoom's notifications to
# /api/zoom/webhook on the WEB project (ADR 0037): set it there. Unset = that
# endpoint answers 503. Deauthorization URL: https://<site>/api/zoom/webhook
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── Skills (docs/adr/0021) — model per tier; unset = the default shown ───────
# summary: briefs, ranking, classification (default claude-haiku-4-5)
ANTHROPIC_SKILL_SUMMARY_MODEL=
# agent: tool-calling agent actions (default claude-sonnet-5-5) — the console assistant (ADR 0025)
ANTHROPIC_SKILL_AGENT_MODEL=
# hard: rare heavy jobs (default claude-opus-5-5)
ANTHROPIC_SKILL_HARD_MODEL=

# ── Template email to contacts (docs/adr/0022) ───────────────────────────────
# Development safety: outside production, bulk/template emails go ONLY to these
# addresses (comma-separated) or whole domains (@example.com). UNSET = NOBODY in
# development — everyone is marked skipped "dev allowlist". Ignored in production.
EMAIL_DEV_ALLOWLIST=
# Limits (with EMAIL_LIMIT_PER_AGENT_DAY / _PER_AGENCY_DAY above). Defaults shown.
# 20 recipients per batch
EMAIL_LIMIT_PER_BATCH=
# 7 — the same person not again within N days
EMAIL_REPEAT_DAYS=
# 500 — pause between two messages of a batch, in ms
EMAIL_SEND_DELAY_MS=

# Smoke tests (pnpm smoke) against the real database — slow from far away. false = `pnpm smoke`
# does nothing and says so; one run anyway: SMOKE_ENABLED=true pnpm smoke. Unset = on.
SMOKE_ENABLED=true

# Google Sheets import by Google's file picker (ADR 0029 amendment). Not secrets — both reach the
# browser. The key: Google Cloud → Credentials → API key, restricted to the console domains AND
# https://docs.google.com/* , API restriction "Google Picker API". The number: the Cloud project's
# NUMBER (not its id) — the same project as GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# ── Phone & SMS (docs/adr/0070) ──────────────────────────────────────────────
# Each agency brings its OWN Twilio: the owner enters its Account SID + API key in
# Connectors → Phone & SMS. There is no platform Twilio key. The API secret is
# encrypted with INTEGRATION_TOKEN_KEY (above), which also signs the webhook URLs —
# so the WEB project needs INTEGRATION_TOKEN_KEY too.
# The web app's public https URL Twilio calls back on (texts, calls). Unset =
# NEXT_PUBLIC_WEB_URL. Dev: an https tunnel to port 3000, e.g. cloudflared.
PHONE_WEBHOOK_BASE=
# 1 = a pretend Twilio (dev only; ignored in production): every setup step succeeds
# and nothing leaves the machine, so the screens can be clicked through without keys.
PHONE_STUB=
# Texts one agent may send in 24 hours (default 100).
SMS_LIMIT_PER_AGENT_DAY=

# ── AI call back (docs/adr/0072) ─────────────────────────────────────────────
# The platform's own Retell account runs every agency's AI calls. Both unset = no
# AI calls (PHONE_STUB=1 in dev gives a pretend Retell). RETELL_AGENT_ID comes from
#   pnpm --filter @repo/ai retell:setup   (needs RETELL_API_KEY + PHONE_WEBHOOK_BASE)
RETELL_API_KEY=
RETELL_AGENT_ID=
# 1 = also check Retell's x-retell-signature (on once a real delivery is seen to
# match; the token in the webhook URL is always checked).
RETELL_VERIFY_SIGNATURE=
# Optional: the Retell voice for retell:setup (default 11labs-Adrian).
RETELL_VOICE_ID=

# ── Smart search (ADR 0031) ──────────────────────────────────────────────────
# Both set = meaning-based search (assistant, knowledge base). Unset = keyword only.
EMBEDDINGS_PROVIDER=
VOYAGE_API_KEY=
