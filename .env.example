# Database — Supabase
# Dev project may be Seoul; production = Sydney later (ADR 0004).
# DATABASE_URL = Transaction pooler (6543) · DIRECT_URL = Direct (5432)
# Percent-encode special characters in the password.
DATABASE_URL=
DIRECT_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — admin provisioning of invited agents. Never expose to the browser.
# Dashboard → Settings → API → Secret keys → reveal the `sb_secret_...` value
# (the legacy `service_role` JWT works too). Optional: without it, invited agents
# claim their membership by signing up with the invite link instead.
SUPABASE_SERVICE_ROLE_KEY=

# Surfaces
NEXT_PUBLIC_WEB_URL=http://web.lvh.me:3000
NEXT_PUBLIC_AGENT_URL=http://agents.lvh.me:3001
NEXT_PUBLIC_AGENCY_URL=http://agency.lvh.me:3001

# UI-first mock (set 1 to skip auth in console middleware while designing)
NEXT_PUBLIC_UI_PREVIEW=0

# Shared session cookie domain (agents.* + agency.*)
COOKIE_DOMAIN=.lvh.me

# AI — the consumer property chat at /chat on the web app.
# Unset is a supported state: /chat answers 503 with a readable reason and every
# other page is unaffected. Nothing else in the platform calls a model.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_CHAT_MODEL=
# Turns one process serves per day before the chat starts refusing. A ceiling on
# cost, not a security control — set a hard spend cap in the Anthropic console
# as well. Defaults to 2000.
AI_CHAT_DAILY_TURN_CAP=

# Media — Cloudflare R2 (M1). Supabase Storage is NOT used.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read URL for the bucket (r2.dev subdomain or your own domain).
# This is NOT the S3 API endpoint — it is what <img src> points at.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Location ---
# One server-side key. Enable "Places API (New)" and "Geocoding API" on it,
# and restrict it by IP — it is never sent to a browser, so an HTTP-referrer
# restriction would block it instead of protecting it.
#
# Everything still works without this: address autocomplete falls back to the
# suburbs already in the database, and search falls back to matching a suburb
# by name. What is lost is the radius — an address with no coordinates cannot
# be found by distance.
GOOGLE_MAPS_API_KEY=

# The SECOND key, for the visual map. A different key from the one above, with
# different restrictions, and the two are not interchangeable:
#
#   GOOGLE_MAPS_API_KEY                  server → Google. Restrict by IP.
#                                        Places API (New) + Geocoding API.
#   NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY  browser → Google. Restrict by HTTP
#                                        referrer. Maps JavaScript API.
#
# NEXT_PUBLIC_ means this one is compiled into the page and is readable by
# anyone. That is how the Maps JavaScript API works and is not a mistake — the
# referrer restriction is what protects it, which is also why the server key
# must never be used here. Put the server key in a browser and an IP rule
# cannot defend it; put the browser key on a server and a referrer rule breaks it.
#
# Without this the maps show a short "not configured" panel and the rest of the
# app is unaffected: pins are still stored, searched and returned.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Email (M4)
RESEND_API_KEY=

# Agent invite claim-link lifetime, in minutes (default 120 = 2 hours).
# A lapsed link is re-sent from the Add Agent wizard, never extended.
AGENT_INVITE_TTL_MINUTES=120

# --- Cache invalidation ---
# The console and the public site are two Next apps in two processes, so the
# console's own revalidatePath cannot clear the public site's cache. It calls
# POST /api/revalidate instead, and this is what proves the caller is the
# console rather than anyone who found the URL.
#
# Any long random string. Unset means the endpoint refuses everything and the
# public site falls back to its own short revalidate windows.
REVALIDATE_SECRET=

# Supabase Storage bucket for listing and agent images (public reads, signed writes).
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media

# --- Scheduled search alerts (ADR 0010) ---
# The person saves a prompt and a time; a cron tick runs the frozen query and
# emails the results. packages/core/src/schedules/ and apps/web/app/api/cron/.

# Spam Act 2003 requires a commercial electronic message to identify its
# sender and give a way to contact them. buildScheduleDigestEmail THROWS
# without these rather than sending a message that cannot comply.
ALERT_SENDER_NAME=
ALERT_SENDER_ADDRESS=
# A full address, never a bare domain. `quotemydecking.com.au` on its own
# reaches Resend as `Sender Name <quotemydecking.com.au>` and is refused —
# it was set that way here for two days and every send failed validation.
# The domain part must be verified in Resend, or sends are refused with 403.
ALERT_EMAIL_FROM=alerts@quotemydecking.com.au
# HMAC key for one-click unsubscribe links. No default anywhere in code: a
# default would be a link anybody could forge for anybody else's alert.
ALERT_UNSUBSCRIBE_SECRET=
# Shared secret on POST/GET /api/cron/alerts. Unset means the endpoint
# refuses everything with 503 — an open trigger here is a bill and a mailing,
# not just a slow page.
CRON_SECRET=
# Trailing-24h spend ceilings, in USD, queried from ai_run. The chat's own
# caps are per-process and keyed on an IP, so they do not cover a cron tick.
AI_DAILY_BUDGET_USD=5
AI_DAILY_BUDGET_USD_PER_USER=0.25
# 1 = build and record every digest but send none. For preview deployments.
ALERTS_DRY_RUN=
